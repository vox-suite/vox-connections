{
  "version": 1,
  "manifest": {
    "external_key": "google-drive-metadata-reader",
    "display_name": "Google Drive metadata reader",
    "protocol": "mcp",
    "endpoint_url": "https://google-read-adapter.example.com/drive/mcp",
    "operator": {
      "operator_id": "vox-deployment",
      "operator_name": "Your reviewed Vox deployment operator"
    },
    "capabilities": [
      {
        "external_key": "google_drive.list_files",
        "display_name": "Google Drive metadata reader",
        "effect": "read",
        "consequential": false,
        "data_recipients": [
          "Google",
          "Your reviewed Vox deployment operator"
        ],
        "access_needs": [
          "https://www.googleapis.com/auth/drive.metadata.readonly"
        ],
        "optional_guarantees": {},
        "input_schema": {
          "type": "object",
          "properties": {
            "page_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "page_token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "name_contains": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "supported_regions": []
      }
    ]
  },
  "metadata": {
    "schema_version": 1,
    "protocol_version": "2025-11-25",
    "auth_mode": "oauth",
    "credential_custody": "platform_held",
    "skills": []
  }
}
